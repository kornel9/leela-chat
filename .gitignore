# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# uv / venv
.venv/
uv.lock.bak

# Jupyter
.ipynb_checkpoints/

# Project data (per CLAUDE.md §5)
data/
weights/
logs/
# Lichess Puzzle DB corpus (Phase 2 Chunk 6.8): network-volume artifact;
# ~500MB compressed + ~2GB uncompressed; not git-friendly. Lives at
# /workspace/lichess_puzzle_db/ on the pod, NOT inside the repo, but
# this catch-all guards against accidentally placing a copy in-tree.
lichess_puzzle_db/

# Secrets
.env*
!.env.example

# OS / editor / agent local state
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/
*.swp
*.swo
*~

# Reference materials (update_research/) — committed by default for
# backup + Claude-Code context (private repo, see update_research/README.md
# and CLAUDE.md §12). Excluded: pre-built binary executables shipped
# inside vendored reference repos (Linux-specific blobs, useless on other
# machines, push individual files near GitHub's >50 MB warn threshold).
update_research/**/stockfish-*-x86-64-*
update_research/**/*.exe
# Windows NTFS "downloaded from internet" metadata sidecars — appear when
# copying files from Windows to WSL; pure noise. Delete on disk too.
*:Zone.Identifier

# Obsidian research vault (leelachat-wiki/). The curated wiki/ notes are
# tracked; these two are not:
#   raw/       — source PDFs that duplicate update_research/pdfs/ (already
#                tracked); committing a second ~94 MB copy is pure bloat.
#   .obsidian/ — per-machine app state (window layout, caches, sync config).
# Un-ignore individual .obsidian/*.json files if you ever want shared vault
# settings under version control.
leelachat-wiki/raw/
leelachat-wiki/.obsidian/
